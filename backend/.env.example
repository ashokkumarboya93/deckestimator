# =============================================
# Deck Estimator — Backend Environment Variables
# =============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/deck_estimator

# JWT Authentication
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Storage (Phase 6)
# STORAGE_PROVIDER=local

# Email (Phase 11)
# EMAIL_PROVIDER=

# AI Service (Phase 9)
# AI_SERVICE_URL=
# AI_API_KEY=

